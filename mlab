        if a > 1, s = s + "; "; end
        s = s + seg;
    end
end

function ub = wilsonUpper(k, n)
    if n <= 0, ub = 1; return; end
    z = 1.645; p = k / n;
    denom = 1 + z^2/n;
    center = p + z^2/(2*n);
    margin = z * sqrt(p*(1-p)/n + z^2/(4*n^2));
    ub = (center + margin) / denom;
end

